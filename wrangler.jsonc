{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limpieza-jci",
  "main": ".open-next/worker.js",
  // Must be >= 2024-09-23 for @opennextjs/cloudflare + nodejs_compat.
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // --- Bindings (provisioned in account 4cf0b376…) ---

  // Cloudflare D1 (serverless SQLite). Schema/seed applied; see prisma/schema.prisma.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "limpieza-jci-db",
      "database_id": "d2aebbba-18e4-40da-99f6-f1f58a243fed"
    }
  ],

  // R2 bucket for cleaning photos (surfaces/equipment only — see spec §9.8).
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "limpieza-jci-fotos" }],

  // Workers KV for short-lived sessions (shared devices, 30-min timeout — §4).
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "2af43ebfb9b6427fa3b29b18789fae4f" }
  ],

  // Queues for offline sync / conflict handling and notification fan-out
  // (§11.3, §12.3) require the Workers Paid plan — enable then uncomment:
  // "queues": {
  //   "producers": [{ "binding": "SYNC_QUEUE", "queue": "limpieza-jci-sync" }],
  //   "consumers": [{ "queue": "limpieza-jci-sync" }]
  // },

  // Daily KPI summary (spec §8.6 / §12.3). Runs 06:00 UTC ≈ 00:00 America/El_Salvador.
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
