// Domain model for LimpiezaJCI (GO-PRY-001-2026). Mirrors spec §7.
//
// Data rules (spec §7.3, NON-NEGOTIABLE):
//  - FKs use onDelete: Restrict — never cascade-delete (the audit log keeps
//    references even to retired entities).
//  - Timestamps are stored in UTC (DateTime). Convert to America/El_Salvador
//    only for display.
//  - Soft-delete (deletedAt) for Room and User — never hard-delete.
//  - AuditEvent is append-only: the application/ORM layer must reject updates;
//    a correction is a NEW event with prevEventId pointing at the original
//    (spec §9.7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  operador
  supervisor
  pci
  gerencia
}

enum RoomState {
  pendiente
  en_limpieza
  pend_verificacion
  con_hallazgos
  liberada
}

enum ProtocolKey {
  rutina
  terminal
  aislamiento
  altoriesgo
}

enum Severity {
  menor
  mayor
  critico
}

enum VerifItemType {
  L // Limpieza
  M // Mantenimiento
}

enum AuditEventType {
  login
  logout
  exec_open
  qr_scan
  protocol_selected
  insumos_selected
  exec_start
  step_confirm
  incident
  photo
  exec_finish
  exec_cancel
  verif_open
  verif_finish
  release
  return_for_correction
  protocol_changed
  room_state_change
  sync_conflict
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  initials  String
  code      String   @unique // SG-014, PCI-003, etc.
  role      UserRole
  area      String
  pinHash   String // argon2id (hash-wasm) — never the raw PIN
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  deletedAt DateTime? // soft-delete

  executions    ExecutionRecord[]
  verifications VerificationRecord[]
  auditEvents   AuditEvent[]
}

model Room {
  id                   String      @id // '201', 'UCI-1', etc.
  tipo                 String
  piso                 String
  qrCode               String      @unique
  highRisk             Boolean     @default(false)
  state                RoomState   @default(pendiente)
  motivo               String?
  motivoSetAt          DateTime?
  suggestedProtocolKey ProtocolKey?
  lastReleaseAt        DateTime?
  createdAt            DateTime    @default(now())
  deletedAt            DateTime? // soft-delete

  executions    ExecutionRecord[]
  verifications VerificationRecord[]
  auditEvents   AuditEvent[]
}

model Protocol {
  key              ProtocolKey @id
  code             String // 'PNT-LIM-001'
  version          String // 'v2.1'
  name             String
  norm             String
  estimatedMinutes Int
  photoRequired    Boolean     @default(false)
  photoSlots       String[]
  steps            Json // [{ idx, label }]
  requiresPciToRelease Boolean @default(false)
  active           Boolean     @default(true)
  effectiveFrom    DateTime    @default(now())

  @@unique([code, version])
}

model Insumo {
  gtin      String   @id // GS1 GTIN
  name      String
  tipo      String // 'desinfectante' | 'limpiador' | 'epp' | 'otro'
  lot       String
  dilution  String?
  active    Boolean  @default(true)
  expiresAt DateTime?
}

model ExecutionRecord {
  id              String    @id @default(cuid())
  roomId          String
  operatorId      String
  protocolCode    String
  protocolVersion String // frozen at execution start (spec §9.5) — immutable
  motivo          String
  qrScannedAt     DateTime
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  stepsConfirmed  Json // [{ idx, at }]
  insumos         Json // [{ gtin, lot }]
  photos          Json // [{ slotIdx, url, takenAt }]
  incidents       Json // [{ stepIdx, text, at }]
  cancelled       Boolean   @default(false)
  cancelReason    String?

  room          Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  operator      User                 @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  verifications VerificationRecord[]
}

model VerificationRecord {
  id                String    @id @default(cuid())
  roomId            String
  executionRecordId String
  verifierId        String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  results           Json // [{ pointId, estado, severity?, note?, at }]
  conformidadPct    Float
  late              Boolean   @default(false)
  decision          String? // 'liberada' | 'devuelta'
  decisionAt        DateTime?

  room      Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  execution ExecutionRecord @relation(fields: [executionRecordId], references: [id], onDelete: Restrict)
  verifier  User            @relation(fields: [verifierId], references: [id], onDelete: Restrict)
}

// Append-only. No updates allowed at the ORM/DB layer (spec §9.7).
model AuditEvent {
  id          String         @id @default(cuid())
  ts          DateTime       @default(now())
  roomId      String?
  actorId     String? // non-null for user actions; 'system' events flagged via isSystem
  isSystem    Boolean        @default(false)
  type        AuditEventType
  detail      String
  payload     Json?
  prevEventId String? // correction chain → original event

  room      Room?       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  prevEvent AuditEvent? @relation("Corrections", fields: [prevEventId], references: [id], onDelete: Restrict)
  corrections AuditEvent[] @relation("Corrections")

  @@index([roomId, ts])
  @@index([type])
}

model VerificationTemplate {
  code               String      @id // 'PVT-LIM-001'
  version            String
  applicableProtocols ProtocolKey[]
  areas              Json // [{ name, items: [{ id, label, type }] }]

  @@unique([code, version])
}
